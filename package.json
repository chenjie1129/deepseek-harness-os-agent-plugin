{
  "name": "dsh-os-agent-plugin",
  "version": "0.3.0",
  "description": "Self-contained Volcengine Mobile Use Agent runtime and configuration UI for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check index.js && node --check volcengine.js && node --check web-config.js && node --check screenshots.js && node --check scripts/build-client.mjs && node --check scripts/verify-harness-install.mjs && node --check examples/headless-run.mjs",
    "test": "vitest run"
  },
  "files": [
    "index.js",
    "volcengine.js",
    "web-config.js",
    "screenshots.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenjie1129/deepseek-harness-os-agent-plugin.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.7.0"
}
